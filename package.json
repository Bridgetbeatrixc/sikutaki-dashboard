{
  "name": "sikutaki-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Sikutaki: dashboard HR dan aplikasi karyawan untuk memantau kesehatan mental secara anonim, dengan akun Supabase dan Asisten AI Gemini.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.13",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.10.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.7.2",
    "wrangler": "4.152.0"
  }
}
