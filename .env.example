# Copy to .env.local for local development. On Vercel, add the same names in
# Project > Settings > Environment Variables.

# Supabase: Project Settings > API (or "Connect" > App Frameworks > Next.js)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx   # the older "anon" key also works

# Gemini (server only, never shown to the browser): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional, defaults to gemini-3.5-flash-lite
GEMINI_MODEL=
