{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sikutaki",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    // Self-reference used by OpenNext; the service name must match the worker name above.
    { "binding": "WORKER_SELF_REFERENCE", "service": "sikutaki" }
  ],
  "observability": { "enabled": true }
  // GEMINI_API_KEY is a secret: `npx wrangler secret put GEMINI_API_KEY`, or Worker > Settings > Variables and Secrets.
}
